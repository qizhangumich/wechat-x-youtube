# ============================================================
# WeCom → Notion Link Collector — Environment Variables
# ============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# Notion Integration
# ------------------------------------------------------------

# Your Notion integration secret.
# Create one at: https://www.notion.so/my-integrations
# Format: secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID of the Notion database where links will be saved.
# Find it in the database page URL:
#   https://www.notion.so/myworkspace/<DATABASE_ID>?v=...
# It is the 32-character hex string (with or without hyphens).
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# iOS Shortcut collect endpoint (share from WeChat → Notion)
# ------------------------------------------------------------

# Any secret string you choose. The iOS Shortcut sends this in X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECT_API_KEY=

# ------------------------------------------------------------
# Telegram Bot (alternative input channel — no ICP/备案 needed)
# ------------------------------------------------------------

# Get this from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated numeric Telegram user IDs who can use the bot.
# Leave blank to allow everyone.  Find your ID by messaging @userinfobot.
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USERS=

# ------------------------------------------------------------
# WeCom (Enterprise WeChat) Callback
# ------------------------------------------------------------

# Token — the same string you enter in the WeCom developer console
# under "Receive Messages" > "Token".
# Leave blank to skip signature verification during local testing.
WECOM_TOKEN=

# 43-character Base64 key from the WeCom developer console.
# Required only if you enable "Encrypted Mode" for callbacks.
# Leave blank for "Plain Text Mode" (fine for local testing).
WECOM_ENCODING_AES_KEY=

# Your WeCom Corporation ID (企业ID).
# Found at: WeCom Admin Panel > My Enterprise > Enterprise Information
WECOM_CORP_ID=

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------

# "development" enables auto-reload and verbose logging.
# "production" disables reload.
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# Phase 3 — Media downloader (yt-dlp)
# ------------------------------------------------------------

# Where downloaded media files land INSIDE the container. On Hetzner,
# bind-mount a host path here when running:
#   docker run ... -v /root/video-output:/data/video-output ...
VIDEO_OUTPUT_DIR=/data/video-output

# Default video resolution cap. yt-dlp picks best ≤ this height.
# Use "best" for unrestricted, "1080" for HD, "720" for compact (default).
DOWNLOAD_MAX_HEIGHT=720

# Whether to start the Notion Status poller on app startup.
# Set to "false" if you only want the Telegram /dl trigger.
DOWNLOAD_POLLER_ENABLED=true

# How often the poller checks Notion for "Download Status = Requested" rows.
POLL_INTERVAL_SECONDS=30

# Hard timeout for a single yt-dlp invocation (seconds).
DOWNLOAD_TIMEOUT_SECONDS=600
